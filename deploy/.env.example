# Copy to deploy/.env and fill with strong random values: openssl rand -base64 24
# deploy/.env is git-ignored (SEC-80).
MYSQL_ROOT_PASSWORD=
WMS_FLYWAY_PASSWORD=
WMS_APP_PASSWORD=
